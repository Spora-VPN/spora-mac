<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Developer ID value of the packet-tunnel entitlement (the app
	     extension's `packet-tunnel-provider` is App Store only). -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider-systemextension</string>
	</array>
	<!-- Network Extension system extensions must be sandboxed; the provider
	     opens UDP sockets to the relay. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Prefixes NEMachServiceName (Info.plist). The extension runs as root,
	     so its group container is root's, not the user's: the app fetches
	     the records and the log from it over that Mach service. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(SPORA_APP_GROUP)</string>
	</array>
</dict>
</plist>
