<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Manage the packet-tunnel via NETunnelProviderManager (connect/use side). -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- Universal links: https://spora.to/s/<token>. Requires the server-side
	     AASA at https://spora.to/.well-known/apple-app-site-association, naming
	     the app ID of the team that signs the app (not served yet). The spora://
	     custom scheme works without it. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:spora.to</string>
	</array>
	<!-- Shared with the other half (app / tunnel extension): connection records
	     and the diagnostic log live in the group container (SporaPaths). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(SPORA_APP_GROUP)</string>
	</array>
</dict>
</plist>
