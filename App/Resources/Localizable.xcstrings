        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздача сейчас недоступна. Перезапустите приложение и попробуйте ещё раз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздача зараз недаступная. Перазапусціце праграму і паспрабуйце яшчэ раз."
          }
