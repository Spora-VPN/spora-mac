    "diagnostics_modal_why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They show us where and how networks block Spora, and help us fix problems."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По ним мы видим, где и как сети блокируют Spora, и исправляем проблемы."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Па іх мы бачым, дзе і як сеткі блакуюць Spora, і выпраўляем праблемы."
          }
        }
      }
    },
    "diagnostics_modal_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With telemetry off, nothing is uploaded. Spora still checks with us about once a day whether your account requires it, and if it does, turns it on and tells you. Feedback comes with a report, and it goes out only when you send it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда телеметрия выключена, ничего не отправляется. Но Spora всё равно примерно раз в день уточняет у нас, не требует ли её ваш аккаунт, и если требует — включает её и сообщает вам об этом. Отчёт прилагается к отзыву и уходит, только когда вы сами его отправите."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі тэлеметрыя выключана, нічога не адпраўляецца. Але Spora ўсё роўна прыкладна раз на дзень пытаецца ў нас, ці не патрабуе яе ваш акаўнт, і калі патрабуе — уключае яе і паведамляе вам пра гэта. Справаздача дадаецца да водгуку і адпраўляецца, толькі калі вы самі яе адправіце."
          }
        }
      }
    },
    "diagnostics_toggle_label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send telemetry automatically"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлять телеметрию автоматически"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адпраўляць тэлеметрыю аўтаматычна"
          }
        }
      }
    },
    "diagnostics_upload_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last upload didn't go through. Spora will try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя отправка не прошла. Spora попробует ещё раз."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Апошняя адпраўка не прайшла. Spora паспрабуе яшчэ раз."
          }
        }
      }
    },
    "diagnostics_switch_failed": {
      "extractionState": "manual",
      "localizations": {
