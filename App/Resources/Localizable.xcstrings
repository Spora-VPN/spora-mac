          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося змяніць наладу. Паспрабуйце яшчэ раз."
          }
        }
      }
    },
    "diagnostics_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telemetry isn't available right now. Spora will try again when you next open it; feedback with a report still works."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телеметрия сейчас недоступна. Spora попробует снова, когда вы в следующий раз откроете приложение; отзыв с отчётом можно отправить и так."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэлеметрыя зараз недаступная. Spora паспрабуе зноў, калі вы наступным разам адкрыеце праграму; водгук са справаздачай можна даслаць і так."
          }
        }
      }
    },
