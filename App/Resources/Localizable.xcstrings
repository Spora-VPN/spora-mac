    "telemetry_required_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account requires that telemetry is enabled (most likely because you've signed up to a promotion). You can keep it enabled, sign in to a different account, or contact support."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вашего аккаунта телеметрия обязательна (скорее всего, потому что вы участвуете в акции). Вы можете оставить её включённой, войти в другой аккаунт или обратиться в поддержку."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вашага акаўнта тэлеметрыя абавязковая (хутчэй за ўсё, таму што вы ўдзельнічаеце ў акцыі). Вы можаце пакінуць яе ўключанай, увайсці ў іншы акаўнт або звярнуцца ў падтрымку."
          }
        }
      }
    },
