    "feedback_handoff_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish sending in the app you picked: nothing reaches us until you do. If that app asks for an address, use the one below."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите отправку в выбранном приложении: пока вы этого не сделаете, к нам ничего не придёт. Если приложение спросит адрес — он ниже."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Завяршыце адпраўку ў выбранай праграме: пакуль вы гэтага не зробіце, да нас нічога не дойдзе. Калі праграма спытае адрас — ён ніжэй."
          }
        }
      }
    },
    "feedback_no_report": {
