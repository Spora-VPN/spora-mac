          }
        }
      }
    },
    "error_extension_not_allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spora's network extension isn't allowed yet. Connect again and allow it in System Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевое расширение Spora ещё не разрешено. Подключитесь снова и разрешите его в Системных настройках."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеткавае пашырэнне Spora яшчэ не дазволена. Падключыцеся зноў і дазвольце яго ў Сістэмных наладах."
          }
        }
      }
    },
    "error_not_in_applications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Spora to the Applications folder, then connect again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместите Spora в папку «Программы» и подключитесь снова."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Перамясціце Spora ў папку праграм і падключыцеся зноў."
          }
        }
      }
    }
