    "feedback_modal_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what went wrong or what could be better."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите, что пошло не так или что можно улучшить."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскажыце, што пайшло не так або што можна палепшыць."
          }
        }
      }
    },
    "feedback_modal_report_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A diagnostic report goes with it: connection records, the app log and crash reports from the last few days. You send it yourself, from an app of your choice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К отзыву прилагается диагностический отчёт: записи о подключениях, журнал приложения и отчёты о сбоях за последние дни. Отправляете его вы сами — через приложение на ваш выбор."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Да водгуку дадаецца дыягнастычная справаздача: запісы пра падключэнні, журнал праграмы і звесткі пра збоі за апошнія дні. Адпраўляеце яе вы самі — праз праграму на ваш выбар."
          }
        }
      }
    },
    "feedback_subject_label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SUBJECT"
